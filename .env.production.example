# =============================================================
# PRODUCTION ENVIRONMENT VARIABLES — set these in Render Dashboard
# (Settings → Environment), NOT in this file. This file is just
# a reference template — do not commit real secrets to GitHub.
# =============================================================

SECRET_KEY=generate-a-long-random-string-here
DEBUG=False
ALLOWED_HOSTS=expiry-alert-backend.onrender.com

# Supabase Postgres connection string — get this from:
# Supabase Dashboard → Project Settings → Database → Connection String → URI
# IMPORTANT: use the "Connection Pooling" URI (port 6543), not the direct one (5432),
# since Render's network works better with pooled connections.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Your deployed Vercel frontend URL(s) — comma separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Email (use a Gmail App Password, not your normal password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
